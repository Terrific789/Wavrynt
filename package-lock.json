{
  "name": "wavrynt-monorepo",
  "version": "0.0.1",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "wavrynt-monorepo",
      "version": "0.0.1",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@wavrynt/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@wavrynt/config": {
      "resolved": "packages/config",
      "link": true
    },
    "packages/cli": {
      "name": "@wavrynt/cli",
      "version": "0.0.1",
      "dependencies": {
        "@wavrynt/config": "0.0.1"
      },
      "bin": {
        "wavrynt": "bin/wavrynt.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/config": {
      "name": "@wavrynt/config",
      "version": "0.0.1",
      "engines": {
        "node": ">=20"
      }
    }
  }
}
